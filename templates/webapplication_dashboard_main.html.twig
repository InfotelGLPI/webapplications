<div style="display: flex;flex-wrap: wrap;">
   <div class="card-body child33" style="text-align:center;font-weight: bold">
      <h2>{{ users_label }}</h2>
      <i class="fa fa-users fa-3x"></i>
      <br>
      <h1>{{ users_value }}</h1>
   </div>

   <div class="card-body child33" style="text-align:center;font-weight: bold">
      <h2>{{ leader_label }}</h2>
      <i class="fa fa-user-cog fa-3x"></i>
      <br>
      <h2>{{ leader_name }}</h2>
   </div>

   <div class="card-body child33" style="text-align:center;font-weight: bold">
      <h2>{{ team_label }}</h2>
      <i class="fa fa-users-cog fa-3x"></i>
      <br>
      <h1>{{ team_number }}</h1>
   </div>
</div>

<div style="display: flex;flex-wrap: wrap;">
   {{ support_html|raw }}
</div>

<div class="card-body border-0">
   {{ summary_title_html|raw }}
</div>

{{ summary_html|raw }}

<div style="display: flex;flex-wrap: wrap;">
   {{ objects_html|raw }}
</div>
