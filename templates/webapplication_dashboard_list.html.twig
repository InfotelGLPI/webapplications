<form name="form" method="post" action="{{ form_action }}">
   <div class="center">
      <table class="tab_cadre_fixe">
         <tr><th colspan="6">{{ add_title }}</th></tr>
         <tr class="tab_bg_1">
            <td class="center">{{ dropdown_html|raw }}</td>
            <td class="tab_bg_2 center" colspan="6">
               {{ hidden_html|raw }}
               {% if can_create %}
                  <button type="submit" name="add" class="btn btn-primary">{{ _x('button', 'Associate') }}</button>
               {% endif %}
            </td>
         </tr>
      </table>
   </div>
   <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
</form>

{% if list_title %}
   <h2 class="card-header d-flex justify-content-between align-items-center">{{ list_title }}</h2>
{% endif %}

{% if is_empty %}
   <table class="tab_cadre_fixe">
      <tbody>
         <tr class="center">
            <td colspan="4">{{ empty_message }}</td>
         </tr>
      </tbody>
   </table>
{% else %}
   {{ objects_html|raw }}
{% endif %}
