{# A titled list of links inside a support card (documents, contracts, links, knowledge
 # base). title_html is a webapplication_dashboard_title render; icon_html is escaped by the
 # caller. #}
{{ title_html|raw }}
<div class="card-body">
    {% if entries is not empty %}
        <div class="list-group list-group-flush">
            {% for entry in entries %}
                <a class="list-group-item list-group-item-action d-flex align-items-center gap-2" href="{{ entry.url }}"
                   {%- if entry.target is defined and entry.target %} target="{{ entry.target }}"{% endif %}>
                    {%- if entry.icon_html is defined and entry.icon_html %}{{ entry.icon_html|raw }}{% endif -%}
                    <span class="text-truncate">{{ entry.label }}</span>
                </a>
            {% endfor %}
        </div>
    {% else %}
        <div class="text-secondary">
            <i class="ti ti-info-circle me-1"></i>{{ empty_message }}
        </div>
    {% endif %}
</div>
