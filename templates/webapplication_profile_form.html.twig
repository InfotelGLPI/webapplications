<div class="firstbloc">
   {% if canedit and openform %}<form method="post" action="{{ form_action }}">{% endif %}
   {{ matrix_html|raw }}
   {% if canedit and closeform %}
      <div class="center">
         <input type="hidden" name="id" value="{{ profiles_id }}">
         <button type="submit" name="update" class="btn btn-primary">{{ _x('button', 'Save') }}</button>
      </div>
      <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
      </form>
   {% endif %}
</div>
