{% import 'components/form/basic_inputs_macros.html.twig' as inputs %}

{% if canedit %}
   <form name="form" method="post" action="{{ form_url }}">
      <div class="center">
         <table class="tab_cadre_fixe">
            <tr><th colspan="6">{{ __('Add an item') }}</th></tr>
            <tr class="tab_bg_1">
               <td class="center">{{ items_dropdown|raw }}</td>
               <td class="tab_bg_2 center" colspan="6">
                  {{ inputs.hidden('_glpi_csrf_token', csrf_token()) }}
                  {{ inputs.hidden('plugin_webapplications_streams_id', stream_id) }}
                  <button type="submit" name="add" class="btn btn-primary">{{ _x('button', 'Add') }}</button>
               </td>
            </tr>
         </table>
      </div>
   </form>
{% endif %}

{{ include('components/datatable.html.twig', datatable_params, with_context = false) }}
