<h2 class="card-header card-web-header d-flex justify-content-between align-items-center">
   {% if icon is defined and icon %}<i class="{{ icon }} fa-1x"></i>{% endif %}
   &nbsp;<span style="margin-right: auto;">{{ title }}</span>
   {% if action_html is defined and action_html %}
      <span style="float: right">{{ action_html|raw }}</span>
   {% endif %}
</h2>
