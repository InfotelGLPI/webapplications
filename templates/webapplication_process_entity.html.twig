{% if canedit %}
   <form name="form" method="post" action="{{ form_url }}">
      <div class="center">
         <table class="tab_cadre_fixe">
            <tr><th colspan="6">{{ add_title }}</th></tr>
            <tr class="tab_bg_1">
               <td class="center">{{ dropdown_html|raw }}</td>
               <td class="tab_bg_2 center" colspan="6">
                  <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
                  <input type="hidden" name="{{ hidden_name }}" value="{{ hidden_value }}">
                  <button type="submit" name="add" class="btn btn-primary">{{ _x('button', 'Add') }}</button>
               </td>
            </tr>
         </table>
      </div>
   </form>
{% endif %}

<div class="spaced" id="tabsbody">
   <table class="tab_cadre_fixe">
      <thead>
         <tr class="tab_bg_2">
            <th colspan="3">{{ list_title }}</th>
         </tr>
      </thead>
      <tbody>
         {% for row in rows %}
            <tr class="tab_bg_2">
               <td colspan="3"><a href="{{ row.url }}">{{ row.name }}</a></td>
            </tr>
         {% endfor %}
      </tbody>
   </table>
</div>
