{{ title_html|raw }}
{% if entries is not empty %}
   <div class="list-group" style="margin-top: 10px;">
      {% for entry in entries %}
         <a class="list-group-item list-group-item-action" href="{{ entry.url }}"{% if entry.target is defined and entry.target %} target="{{ entry.target }}"{% endif %}>{% if entry.icon_html is defined and entry.icon_html %}{{ entry.icon_html|raw }} {% endif %}{{ entry.label }}</a>
      {% endfor %}
   </div>
   {{ break_after_list|default('')|raw }}
{% else %}
   {{ empty_message }}
   {{ break_after_empty|default('')|raw }}
{% endif %}
