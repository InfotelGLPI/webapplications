<form name="form" method="post" action="{{ item_form_url }}">
   <div class="center">
      <table class="tab_cadre_fixe">
         <tr><th colspan="2">{{ __('Setting up PDF printing', 'webapplications') }}</th></tr>
         <tr class="tab_bg_1">
            <td>{{ __('Use description field', 'webapplications') }}</td>
            <td>{{ use_fields_description_dropdown|raw }}</td>
         </tr>
         <tr class="tab_bg_1">
            <td>{{ __('Use field', 'webapplications') }}</td>
            <td>{{ fields_dropdown|raw }}</td>
         </tr>
         <tr>
            <td class="tab_bg_2 center" colspan="2">
               <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
               <input type="hidden" name="id" value="{{ item_id }}">
               <button type="submit" name="update" class="btn btn-primary">
                  {{ _x('button', 'Save') }}
               </button>
            </td>
         </tr>
      </table>
   </div>
</form>
