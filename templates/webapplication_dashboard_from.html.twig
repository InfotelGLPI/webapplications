{# One object type of the loaded appliance (Dashboard::showFromDashboard()), as a card:
 # title_html is a webapplication_dashboard_title render, then the linked objects. #}
<div class="col-12 col-xl-6">
    <div class="card h-100">
        {{ title_html|raw }}
        <div class="card-body">
            {% if entries is not empty %}
                <div class="row g-2">
                    {% for entry in entries %}
                        <div class="col-12 col-md-6">
                            <a class="d-block border rounded px-3 py-2 text-reset text-truncate" href="{{ entry.url }}">{{ entry.label }}</a>
                        </div>
                    {% endfor %}
                </div>
            {% else %}
                <div class="text-secondary"><i class="ti ti-info-circle me-1"></i>{{ __('No results found') }}</div>
            {% endif %}
        </div>
    </div>
</div>
